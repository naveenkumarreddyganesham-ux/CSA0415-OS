
#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

#define N 5

sem_t forks[N];
sem_t room;

void *philosopher(void *arg) {
    int id = *(int *)arg;
    int left = id;
    int right = (id + 1) % N;

    printf("Philosopher %d is Thinking\n", id + 1);

    sem_wait(&room);
    sem_wait(&forks[left]);
    sem_wait(&forks[right]);

    printf("Philosopher %d is Eating\n", id + 1);

    sem_post(&forks[right]);
    sem_post(&forks[left]);
    sem_post(&room);

    printf("Philosopher %d finished Eating\n", id + 1);

    return NULL;
}

int main() {
    pthread_t thread[N];
    int id[N], i;

    sem_init(&room, 0, N - 1);

    for (i = 0; i < N; i++)
        sem_init(&forks[i], 0, 1);

    for (i = 0; i < N; i++) {
        id[i] = i;
        pthread_create(&thread[i], NULL,
                       philosopher, &id[i]);
    }

    for (i = 0; i < N; i++)
        pthread_join(thread[i], NULL);

    for (i = 0; i < N; i++)
        sem_destroy(&forks[i]);

    sem_destroy(&room);

    return 0;
}


#include <stdio.h>

int main()
{
    int block[20], process[20], alloc[20];
    int nb, np, choice, i, j, best;

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);

    printf("Enter block sizes:\n");
    for (i = 0; i < nb; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter process sizes:\n");
    for (i = 0; i < np; i++)
        scanf("%d", &process[i]);

    printf("1.First Fit  2.Best Fit  3.Worst Fit\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    for (i = 0; i < np; i++)
        alloc[i] = -1;

    for (i = 0; i < np; i++)
    {
        best = -1;

        for (j = 0; j < nb; j++)
        {
            if (block[j] >= process[i])
            {
                if (choice == 1)
                {
                    best = j;
                    break;
                }
                else if (choice == 2)
                {
                    if (best == -1 || block[j] < block[best])
                        best = j;
                }
                else if (choice == 3)
                {
                    if (best == -1 || block[j] > block[best])
                        best = j;
                }
            }
        }

        if (best != -1)
        {
            alloc[i] = best;
            block[best] -= process[i];
        }
    }

    printf("\nProcess Size\tAllocated Block\n");

    for (i = 0; i < np; i++)
    {
        printf("%d\t\t", process[i]);

        if (alloc[i] != -1)
            printf("%d\n", alloc[i] + 1);
        else
            printf("Not Allocated\n");
    }

    return 0;
}

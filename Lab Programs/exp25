
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main() {
    int fd, flags;
    struct stat st;
    DIR *dir;
    struct dirent *entry;
    off_t pos;
    int count = 0;

    fd = open("/dev/null", O_RDONLY);

    if (fd == -1) {
        perror("open");
        return 1;
    }

    flags = fcntl(fd, F_GETFL);

    if (flags == -1)
        perror("fcntl");
    else
        printf("fcntl: File opened in read mode\n");

    pos = lseek(fd, 0, SEEK_SET);

    if (pos == -1)
        perror("lseek");
    else
        printf("lseek: File position = %ld\n", (long)pos);

    if (fstat(fd, &st) == -1)
        perror("fstat");
    else
        printf("stat: File size = %ld bytes\n",
               (long)st.st_size);

    close(fd);

    dir = opendir(".");

    if (dir == NULL) {
        perror("opendir");
        return 1;
    }

    printf("opendir: Directory opened successfully\n");
    printf("readdir: Directory entries:\n");

    while ((entry = readdir(dir)) != NULL && count < 5) {
        printf("%s\n", entry->d_name);
        count++;
    }

    closedir(dir);

    return 0;
}

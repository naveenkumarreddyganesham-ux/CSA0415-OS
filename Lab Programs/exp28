
#include <stdio.h>
#include <string.h>

int main() {
    char lines[20][100], word[50];
    int n, i, found = 0;

    printf("Enter number of lines: ");
    scanf("%d", &n);

    if (n < 1 || n > 20) {
        printf("Invalid number of lines\n");
        return 1;
    }

    printf("Enter the lines:\n");

    for (i = 0; i < n; i++) {
        scanf(" %99[^\n]", lines[i]);
    }

    printf("Enter word to search: ");
    scanf("%49s", word);

    printf("\nMatching Lines:\n");

    for (i = 0; i < n; i++) {
        if (strstr(lines[i], word) != NULL) {
            printf("%s\n", lines[i]);
            found = 1;
        }
    }

    if (found == 0)
        printf("No matching lines found\n");

    return 0;
}

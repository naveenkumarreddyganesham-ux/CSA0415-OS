
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

int main()
{
    int shmid;
    char *shm;

    shmid = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0666);

    if (shmid == -1)
    {
        perror("shmget");
        return 1;
    }

    shm = (char *)shmat(shmid, NULL, 0);

    if (shm == (char *)-1)
    {
        perror("shmat");
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    pid_t pid = fork();

    if (pid == 0)
    {
        printf("Child Process: Reading shared memory\n");
        printf("Message: %s\n", shm);
        shmdt(shm);
        exit(0);
    }
    else if (pid > 0)
    {
        strcpy(shm, "Hello from Parent Process!");
        printf("Parent Process: Message written\n");
        wait(NULL);
    }
    else
    {
        perror("fork");
    }

    shmdt(shm);
    shmctl(shmid, IPC_RMID, NULL);

    return 0;
}

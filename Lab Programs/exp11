
#include <stdio.h>
#include <pthread.h>

void *thread_function(void *arg)
{
    printf("Child Thread is running\n");
    return NULL;
}

int main()
{
    pthread_t thread;

    pthread_create(&thread, NULL, thread_function, NULL);

    printf("Main Thread is running\n");

    pthread_join(thread, NULL);

    printf("Both threads completed\n");

    return 0;
}

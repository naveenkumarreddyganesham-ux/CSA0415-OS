
#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>

sem_t mutex, wrt;
int readcount = 0;
int data = 10;

void *reader(void *arg) {
    int id = *(int *)arg;

    sem_wait(&mutex);
    readcount++;

    if (readcount == 1)
        sem_wait(&wrt);

    sem_post(&mutex);

    printf("Reader %d reads data = %d\n", id, data);

    sem_wait(&mutex);
    readcount--;

    if (readcount == 0)
        sem_post(&wrt);

    sem_post(&mutex);
    return NULL;
}

void *writer(void *arg) {
    int id = *(int *)arg;

    sem_wait(&wrt);

    data += 10;
    printf("Writer %d writes data = %d\n", id, data);

    sem_post(&wrt);
    return NULL;
}

int main() {
    pthread_t r[2], w[2];
    int id[2] = {1, 2};

    sem_init(&mutex, 0, 1);
    sem_init(&wrt, 0, 1);

    pthread_create(&r[0], NULL, reader, &id[0]);
    pthread_join(r[0], NULL);

    pthread_create(&w[0], NULL, writer, &id[0]);
    pthread_join(w[0], NULL);

    pthread_create(&r[1], NULL, reader, &id[1]);
    pthread_join(r[1], NULL);

    pthread_create(&w[1], NULL, writer, &id[1]);
    pthread_join(w[1], NULL);

    sem_destroy(&mutex);
    sem_destroy(&wrt);

    return 0;
}

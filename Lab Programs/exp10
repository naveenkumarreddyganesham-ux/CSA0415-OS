
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <sys/wait.h>
#include <unistd.h>

struct message
{
    long type;
    char text[100];
};

int main()
{
    int msgid;
    struct message msg;

    msgid = msgget(IPC_PRIVATE, IPC_CREAT | 0666);

    if (msgid == -1)
    {
        perror("msgget");
        return 1;
    }

    pid_t pid = fork();

    if (pid == 0)
    {
        if (msgrcv(msgid, &msg, sizeof(msg.text), 1, 0) == -1)
        {
            perror("msgrcv");
            exit(1);
        }

        printf("Child Process: Message received\n");
        printf("Message: %s\n", msg.text);
        exit(0);
    }
    else if (pid > 0)
    {
        msg.type = 1;
        strcpy(msg.text, "Hello from Parent Process!");

        if (msgsnd(msgid, &msg, sizeof(msg.text), 0) == -1)
        {
            perror("msgsnd");
            msgctl(msgid, IPC_RMID, NULL);
            return 1;
        }

        printf("Parent Process: Message sent\n");
        wait(NULL);
        msgctl(msgid, IPC_RMID, NULL);
    }
    else
    {
        perror("fork");
        msgctl(msgid, IPC_RMID, NULL);
        return 1;
    }

    return 0;
}
